{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Json": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/watchparty.db"
  },
  "Auth": {
    "InviteCode": "troque-este-codigo"
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "Storage": {
    "RootPath": "data/media",
    "MaxUploadBytes": 21474836480,
    "UserQuotaBytes": 0,
    "MinFreeBytes": 2147483648
  },
  "Backup": {
    "Enabled": true,
    "Directory": "data/backups",
    "IntervalHours": 24,
    "Keep": 7
  },
  "Maintenance": {
    "RoomInactiveDays": 30,
    "ChatRetentionDays": 180
  },
  "MobileApp": {
    "LatestBuild": 0,
    "LatestVersion": null,
    "ApkPath": "data/app/WatchParty.apk"
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "Preset": "veryfast",
    "Crf": 23,
    "MaxHeight": 1080,
    "Hls": {
      "Enabled": true,
      "SegmentSeconds": 6
    }
  },
  "Voice": {
    "Provider": "mesh",
    "LiveKit": { "Url": "", "ApiKey": "", "ApiSecret": "" }
  },
  "WebRtc": {
    "IceServers": [
      { "Urls": [ "stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302" ] }
    ]
  }
}
